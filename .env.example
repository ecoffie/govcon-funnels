# ========================================
# GOVCON FUNNELS - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local and fill in your actual values

# -----------------------
# GO HIGH LEVEL CRM
# -----------------------
# Get these from your GoHighLevel account:
# 1. Go to Settings > API Access
# 2. Generate an API key with "Contacts" permissions
# 3. Get your Location ID from Settings > Business Profile

GHL_API_KEY=your_gohighlevel_api_key_here
GHL_LOCATION_ID=your_gohighlevel_location_id_here

# -----------------------
# OPTIONAL: WEBHOOK (Zapier, Make, n8n, etc.)
# -----------------------
# If you want to also send leads to a webhook service:
# CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx/

# -----------------------
# SLACK (lead notifications)
# -----------------------
# Incoming Webhook URL: Slack App > Incoming Webhooks > Add to Workspace > Copy Webhook URL
# Sends a notification with name, email, what they signed up for (source), and phone.
SLACK_LEAD_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# -----------------------
# SLACK (task bot - optional)
# -----------------------
# For internal dashboard task updates via Slack messages (e.g. "Task T-001 done").
# Create a Slack App, enable Event Subscriptions, set Request URL to https://your-domain/api/slack/events.
# Subscribe to message events; install app and add Bot User OAuth Token + Signing Secret.
# SLACK_SIGNING_SECRET=your_signing_secret
# SLACK_BOT_TOKEN=xoxb-your_bot_token

# -----------------------
# TASKS DATABASE (internal dashboard)
# -----------------------
# Postgres connection string (Vercel Postgres, Supabase, Neon, etc.). Run scripts/schema.sql to create the tasks table.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# -----------------------
# STRIPE (for paid funnels)
# -----------------------
# Get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PRICE_ID_BOOTCAMP=price_xxxxx
